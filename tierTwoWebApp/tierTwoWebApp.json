{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus"
    },
    "networkModuleName": {
      "value": "myVNetModule"
    },
    "numOfSubnets": {
      "value": 2
    },
    "overallNetworkName": {
      "value": "myVNet"
    },
    "addressSpace": {
      "value": "10.0.0.0/16"
    },
    "publicIPModuleName": {
      "value": "myPublicIPModule"
    },
    "publicIPName": {
      "value": "myPublicIP"
    },
    "publicIPSKU": {
      "value": "Standard"
    },
    "publicAllocationMethod": {
      "value": "Static"
    },
    "nicModuleName": {
      "value": "myNICModule"
    },
    "nicName": {
      "value": "myNIC"
